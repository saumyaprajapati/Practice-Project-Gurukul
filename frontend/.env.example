# Copy to .env.local and fill in. See supabase/README-phase5.md.

# App (browser + server components) — publishable key only, RLS protects the data.
NEXT_PUBLIC_SUPABASE_URL=https://<project>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# scripts/ only (user migration, load test) — never used by the app itself.
SUPABASE_URL=https://<project>.supabase.co
SUPABASE_SECRET_KEY=
