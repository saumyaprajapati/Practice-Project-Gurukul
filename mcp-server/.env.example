# Copy to .env and fill in. Same values as frontend/.env.local:
SUPABASE_URL=https://<project-ref>.supabase.co
# The PUBLISHABLE key (sb_publishable_...). Never the secret key.
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Where the Gurukul website runs (used for links in tool results).
GURUKUL_APP_URL=http://localhost:3000

# Public address of THIS server (without /mcp). Set it to the tunnel or
# deployed URL when web agents (claude.ai, ChatGPT) connect.
MCP_PUBLIC_URL=http://localhost:8000

# 127.0.0.1 = this machine only. 0.0.0.0 in Docker / on a server.
HOST=127.0.0.1
PORT=8000
